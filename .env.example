# Copy this file to `.env` and fill in your key.
# `.env` is git-ignored; `.env.example` is committed.

# Groq API key — get one at https://console.groq.com/keys
GROQ_API_KEY=

# Which Groq model to use for query rewriting / reranking / loop analysis.
# Options as of Nov 2025: openai/gpt-oss-20b, qwen/qwen3-32b, llama-3.3-70b-versatile
GROQ_MODEL=openai/gpt-oss-20b
